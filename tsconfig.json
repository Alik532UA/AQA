{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"paths": {
			"$lib": [
				"./src/lib"
			],
			"$lib/*": [
				"./src/lib/*"
			],
			"#lib": [
				"./src/lib"
			],
			"#lib/*": [
				"./src/lib/*"
			]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"vitest.config.ts"
	]
}